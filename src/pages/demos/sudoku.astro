---
import DemoLayout from '../../layouts/DemoLayout.astro';

export const prerender = true;

const title = 'Sudoku';
const description =
  'Sudoku solver and generator. Generate puzzles, fill in numbers, and solve with backtracking. Click and type, or use the number pad.';
const permalink = `${Astro.site.href}demos/sudoku`;
---

<DemoLayout
  title={title}
  description={description}
  permalink={permalink}
  current="demos">
  <div>
    <h2>Sudoku</h2>
    <span>
      <span>click</span> select
      <span>·</span>
      <span>1-9</span> fill
      <span>·</span>
      <span>hjkl</span> move
    </span>
    <div>
      <a
        href="/blog/sudoku-backtracking-in-python">
        [blog]
      </a>
      <a
        href="https://github.com/andrewthecodertx/javascript-sudokusolver"
        target="_blank"
        rel="noopener noreferrer">
        [source]
      </a>
    </div>
  </div>

  <div>
    <button
      id="sudoku-generate">
      generate
    </button>
    <button
      id="sudoku-solve"
      disabled>
      solve
    </button>
    <button
      id="sudoku-check"
      disabled>
      check
    </button>
    <button
      id="sudoku-clear">
      clear
    </button>
    <span id="sudoku-check-result"></span>
  </div>

  <div>
    <canvas id="sudoku-grid"></canvas>
    <div id="sudoku-number-pad">
      <button>
        1
      </button>
      <button>
        2
      </button>
      <button>
        3
      </button>
      <button>
        4
      </button>
      <button>
        5
      </button>
      <button>
        6
      </button>
      <button>
        7
      </button>
      <button>
        8
      </button>
      <button>
        9
      </button>
      <div></div>
      <button>
        C
      </button>
      <div></div>
    </div>
  </div>

  <script is:inline src="/js/sudoku.js" data-astro-rerun></script>
</DemoLayout>
